# EchoCare AI Environment Configuration
# Copy to .env and populate with your keys if using Gemini live mode.

# Google Gemini API Key (Optional: system runs in robust deterministic mode without key)
GEMINI_API_KEY=

# Server Port & Environment
PORT=3000
NODE_ENV=development

# Google Gemini API Key (Optional teacher / fallback mode)
GEMINI_API_KEY=""

# Custom LLM & LoRA Adapter Configuration
ECHOCARE_BASE_MODEL="Qwen/Qwen2.5-0.5B-Instruct"
ECHOCARE_ADAPTER_PATH="./models/echocare-lora-adapter"
ECHOCARE_INFERENCE_ENGINE="hybrid" # Options: "hybrid", "gemini_teacher", "deterministic"
ECHOCARE_MAX_SEQ_LENGTH="1024"

# Voice & Multilingual Preferences
ECHOCARE_WAKE_WORD="EchoCare" # Options: "EchoCare", "Hey Echo", "Echo"
ECHOCARE_DEFAULT_LANG="en-US" # Options: "en-US", "ta-IN", "hi-IN"
ECHOCARE_AUTO_LISTEN="true"
